{
  "manifest_version": 3,
  "name": "Cig",
  "version": "0.1.0",
  "description": "Scrolling Twitter is a cigarette for your eyes. One burns down as you scroll.",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["ext/loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/overlay.js", "src/cigarette.js", "src/fx.js", "src/noise.js", "vendor/three/build/three.module.js"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ]
}
